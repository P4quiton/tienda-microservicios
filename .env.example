# Plantilla de nombres, no configuración funcional. Cada servicio tendrá su archivo local.
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=db_usuarios
DB_USERNAME=usr_usuarios
DB_PASSWORD=REPLACE_ME
JWT_ISSUER=api-usuarios
JWT_AUDIENCE=tienda-microservicios
JWT_TTL_SECONDS=3600
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=db_resenas
MONGO_USERNAME=usr_resenas
MONGO_PASSWORD=REPLACE_ME
API_USUARIOS_URL=http://api-usuarios:8001
API_PRODUCTOS_URL=http://api-productos:8002
API_ENVIOS_URL=http://api-envios:8003
API_INVENTARIO_URL=http://api-inventario:8004
API_CARRITO_URL=http://api-carrito:8005
API_PEDIDOS_URL=http://api-pedidos:8006
API_PAGOS_URL=http://api-pagos:8007
API_RESENAS_URL=http://api-resenas:8008
# Ejemplo: secreto independiente Pedidos -> Pagos, nunca real en Git
SERVICE_TOKEN_PEDIDOS_PAGOS=REPLACE_ME


# Infraestructura PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_ME

# Credenciales independientes por microservicio
POSTGRES_USUARIOS_PASSWORD=REPLACE_ME
POSTGRES_PRODUCTOS_PASSWORD=REPLACE_ME
POSTGRES_ENVIOS_PASSWORD=REPLACE_ME
POSTGRES_INVENTARIO_PASSWORD=REPLACE_ME
POSTGRES_CARRITO_PASSWORD=REPLACE_ME
POSTGRES_PEDIDOS_PASSWORD=REPLACE_ME
POSTGRES_PAGOS_PASSWORD=REPLACE_ME

# Infraestructura MongoDB
MONGO_INITDB_ROOT_USERNAME=admin_tienda
MONGO_INITDB_ROOT_PASSWORD=REPLACE_ME
MONGO_RESENAS_PASSWORD=REPLACE_ME

# Puertos publicados para desarrollo local
POSTGRES_HOST_PORT=15432
MONGO_HOST_PORT=27017