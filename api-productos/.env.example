APP_NAME=api-productos
APP_ENV=local
APP_KEY=base64:REPLACE_WITH_A_GENERATED_KEY
APP_DEBUG=false
APP_URL=http://localhost:8002
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Local fuera de Docker: 127.0.0.1 y el puerto publicado POSTGRES_HOST_PORT (15432).
# Dentro de Docker: DB_HOST=postgres, DB_PORT=5432. El puerto del host no sirve entre contenedores.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=15432
DB_DATABASE=db_productos
DB_USERNAME=usr_productos
DB_PASSWORD=REPLACE_ME
DB_SSLMODE=disable

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

JWT_ISSUER=api-usuarios
JWT_AUDIENCE=tienda-microservicios
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
# IP/CIDR de proxies controlados, separados por comas. Vacía ignora X-Forwarded-For.
TRUSTED_PROXIES=
# Orígenes completos separados por comas (p. ej. http://localhost:4200). Vacío: sin CORS.
# No usar '*'. Con el frontend servido por Nginx en el mismo origen no hace falta ningún valor.
CORS_ALLOWED_ORIGINS=
