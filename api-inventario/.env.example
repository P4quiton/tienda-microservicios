PORT=8004

# Local fuera de Docker: 127.0.0.1 y el puerto publicado POSTGRES_HOST_PORT (15432).
# Dentro de Docker: DB_HOST=postgres, DB_PORT=5432. El puerto del host no sirve entre contenedores.
DB_HOST=127.0.0.1
DB_PORT=15432
DB_DATABASE=db_inventario
DB_USERNAME=usr_inventario
DB_PASSWORD=REPLACE_ME
DB_SSLMODE=disable

JWT_ISSUER=api-usuarios
JWT_AUDIENCE=tienda-microservicios
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem

# Mismo valor que api-pedidos (SERVICE_TOKEN_PEDIDOS_INVENTARIO). Nombre unico del equipo.
SERVICE_TOKEN_PEDIDOS_INVENTARIO=REPLACE_WITH_PEDIDOS_TO_INVENTARIO_SECRET
PRODUCTOS_API_BASE_URL=http://api-productos:8002

RATE_LIMIT_CONSULTA_POR_MIN=120
RATE_LIMIT_MUTACION_POR_MIN=30
RATE_LIMIT_INTERNA_POR_MIN=300
RATE_LIMIT_MAX_CLIENTES=10000
TRUSTED_PROXIES=
