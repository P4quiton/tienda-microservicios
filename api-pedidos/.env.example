APP_NAME=api-pedidos
APP_ENV=local
APP_DEBUG=false
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=db_pedidos
DB_USERNAME=usr_pedidos
DB_PASSWORD=
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
API_CARRITO_URL=http://api-carrito:8005
SERVICE_TOKEN_PEDIDOS_CARRITO=
API_PRODUCTOS_URL=http://api-productos:8002
API_INVENTARIO_URL=http://api-inventario:8004
API_PAGOS_URL=http://api-pagos:8007
API_ENVIOS_URL=http://api-envios:8003
SERVICE_TOKEN_PEDIDOS_INVENTARIO=
SERVICE_TOKEN_PEDIDOS_PAGOS=
SERVICE_TOKEN_PEDIDOS_ENVIOS=
SERVICE_TOKEN_PAGOS_PEDIDOS=
SERVICE_TOKEN_ENVIOS_PEDIDOS=
CACHE_STORE=file
# Orígenes completos separados por comas (p. ej. http://localhost:4200). Vacío: sin CORS.
# No usar '*'. Con el frontend servido por Nginx en el mismo origen no hace falta ningún valor.
CORS_ALLOWED_ORIGINS=
# Rate limiting (peticiones/min, contador por instancia) y tope del cuerpo JSON
RATE_LIMIT_CONSULTA_POR_MIN=120
RATE_LIMIT_MUTACION_POR_MIN=30
RATE_LIMIT_CHECKOUT_POR_MIN=5
RATE_LIMIT_INTERNA_POR_MIN=300
MAX_JSON_BYTES=262144
