PORT=8008

# Desarrollo local: MongoDB publicado por Docker Compose en localhost:27017.
# Dentro de Docker: host=mongodb, puerto=27017.
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=db_resenas
MONGO_USERNAME=usr_resenas
MONGO_PASSWORD=REPLACE_ME
MONGO_AUTH_SOURCE=db_resenas
MONGO_TIMEOUT_MS=3000

JWT_ISSUER=api-usuarios
JWT_AUDIENCE=tienda-microservicios
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem

# Local: http://127.0.0.1:8002. En Docker: http://api-productos:8002.
API_PRODUCTOS_URL=http://127.0.0.1:8002
