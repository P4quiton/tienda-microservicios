# Plantilla sin secretos. Copiar a .env (ignorado por Git) y reemplazar REPLACE_ME.
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=db_envios
DB_USERNAME=usr_envios
DB_PASSWORD=REPLACE_ME

# Verificación de JWT RS256 (solo clave pública; la privada vive en api-usuarios)
JWT_ISSUER=api-usuarios
JWT_AUDIENCE=tienda-microservicios
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem

# Identidad interna por pares (un secreto distinto por dirección)
# Pedidos -> Envíos: lo que Envíos acepta
SERVICE_TOKEN_PEDIDOS_ENVIOS=REPLACE_ME
# Envíos -> Pedidos: lo que Envíos envía al consultar titularidad
SERVICE_TOKEN_ENVIOS_PEDIDOS=REPLACE_ME
API_PEDIDOS_URL=http://api-pedidos:8006
PEDIDOS_TIMEOUT_SECONDS=3
NOTIFICACION_INTERVALO_SECONDS=30
